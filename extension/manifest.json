{
  "manifest_version": 3,
  "name": "MangaTranslator Bridge",
  "version": "1.0.0",
  "description": "Связывает страницу чтения манги с локальным приложением MangaTranslator и показывает перевод поверх картинок.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MangaTranslator"
  },
  "permissions": ["storage", "tabs", "activeTab", "scripting", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "ws://127.0.0.1/*"],
  "commands": {
    "toggle-translation": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Включить или выключить перевод на текущей странице"
    }
  }
}

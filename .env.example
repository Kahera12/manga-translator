# Copy this file to `.env` (same folder) and fill in the key you use.
# `.env` is git-ignored. Keys are never logged and never written to the project.
#
# Only ONE provider key is needed - the one you select in Settings → Translation.
# The provider is switched in the app; TRANSLATION_PROVIDER below just preselects it.

# --- which provider to use -------------------------------------------------
# gemini | google-translate | openai | deepseek | openrouter | anthropic |
# mistral | groq | together | fireworks | deepinfra | cerebras | xai |
# perplexity | nvidia | sambanova | github-models | moonshot | zhipu | qwen |
# siliconflow | azure-openai | ollama | lmstudio | llamacpp | vllm |
# deepl | yandex | microsoft | libretranslate | mymemory | fake
TRANSLATION_PROVIDER=gemini
TEXT_MODEL=gemini-3.8-flash
TARGET_LANGUAGE=Russian

# Optional: override the endpoint (tests, proxies, Azure, self-hosted servers)
# TRANSLATION_BASE_URL=https://generativelanguage.googleapis.com

# --- API keys (fill in the one you need; the rest can stay empty) ---------
GEMINI_API_KEY=
# GOOGLE_API_KEY=                 # also accepted for Gemini / Google Translate
# GOOGLE_TRANSLATE_API_KEY=       # Google Cloud Translation v2
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# DEEPINFRA_API_KEY=
# CEREBRAS_API_KEY=
# XAI_API_KEY=
# PERPLEXITY_API_KEY=
# NVIDIA_API_KEY=
# SAMBANOVA_API_KEY=
# GITHUB_TOKEN=                   # GitHub Models (models:read scope)
# MOONSHOT_API_KEY=
# ZHIPU_API_KEY=
# DASHSCOPE_API_KEY=              # Alibaba Qwen
# SILICONFLOW_API_KEY=
# AZURE_OPENAI_API_KEY=
# DEEPL_API_KEY=                  # DeepL (keys ending in :fx are the free tier)
# YANDEX_API_KEY=                 # Yandex Cloud service-account API key
# AZURE_TRANSLATOR_KEY=           # Microsoft Translator
# LIBRETRANSLATE_API_KEY=         # only if your server requires one
#
# Local servers (Ollama, LM Studio, llama.cpp, vLLM, LibreTranslate) need no key:
#   ollama serve                     -> http://localhost:11434/v1
#   LM Studio "Start server"         -> http://localhost:1234/v1
#   docker run -p 5000:5000 libretranslate/libretranslate
# MyMemory works without any key at all (anonymous daily quota) - handy for a
# first smoke test of the whole pipeline.

# --- OCR ------------------------------------------------------------------
OCR_ENGINE=rapid            # rapid | paddle | stub
OCR_MIN_CONFIDENCE=0.55

# --- Change detection defaults (also editable in Settings) ---------------
POLL_INTERVAL_MS=150
STABLE_DURATION_MS=350
CHANGE_THRESHOLD=0.075

# --- Misc -----------------------------------------------------------------
TRANSLATE_SFX=false
CONTEXT_PAGES=2
CACHE_ENABLED=true
CACHE_MAX_MB=1000
DEBUG_MODE=false
